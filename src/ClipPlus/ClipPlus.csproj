<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>

    <!-- WPF owns the UI. WinForms is referenced only for NotifyIcon + Screen. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Deliberately OFF: with both UseWPF and UseWindowsForms the SDK would
         inject System.Windows.* AND System.Windows.Forms.* implicit usings,
         which collide on Clipboard / Application / MessageBox / Point.
         Every file below declares its usings explicitly instead. -->
    <ImplicitUsings>disable</ImplicitUsings>

    <RootNamespace>ClipPlus</RootNamespace>
    <AssemblyName>ClipPlus</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
